# Copiar este archivo como .env y completar con valores propios.
# Nunca subir el archivo .env al repositorio.

# Servidor
PORT=3000

# Conexión a PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=catalogo_db

# JWT
JWT_SECRET=
JWT_EXPIRES_IN=1h

# Administrador inicial (lo usa: npm run admin:crear)
ADMIN_NOMBRE=Administrador
ADMIN_CORREO=admin@catalogo.test
ADMIN_PASSWORD=