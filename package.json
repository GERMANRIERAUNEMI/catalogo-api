{
  "name": "catalogo-api",
  "version": "1.0.0",
  "description": "API REST de catálogo de productos con favoritos y acceso por roles (Node.js, Express, PostgreSQL, JWT)",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "db:init": "node scripts/init-db.js",
    "db:reset": "node scripts/init-db.js --reset",
    "admin:crear": "node scripts/crear-admin.js",
    "token:vencido": "node scripts/token-vencido.js",
    "test": "node scripts/run-tests.js",
    "test:persistencia": "node scripts/run-tests.js --persistencia"
  },
  "keywords": ["api", "express", "postgresql", "jwt"],
  "author": "German Riera Rebolledo",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "newman": "^6.2.3",
    "nodemon": "^3.1.14"
  }
}
